---
import { getCollection } from "astro:content";
import BlogLayout from "../layouts/BlogLayout.astro";

const posts = await getCollection("blog");

const tags = ["development", "design", "user experience"];
---

<BlogLayout title="Home" posts={posts}>
  <p class="eyebrow">WELCOME TO OUR BLOG</p>
  <h1>Behind the project</h1>
  <p class="description">
    This is a page where we documented and reflected every step of our project.
    We share the procress behind what we achieved including the struggles and
    steps we took to it.
  </p>
</BlogLayout>
